{
  "name": "wickey",
  "version": "0.2.1",
  "description": "Local proxy that hands out short-lived, limited LLM API keys from an encrypted, passphrase-locked vault.",
  "type": "module",
  "bin": {
    "wickey": "bin/wickey.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "native",
    "dist",
    "web/dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node src/cli.ts start",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "check": "svelte-check --workspace web --tsconfig ./tsconfig.json",
    "prepare": "npm run build",
    "build:cli": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && npm run build:cli",
    "postpack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civarry/wickey.git"
  },
  "homepage": "https://github.com/civarry/wickey#readme",
  "bugs": {
    "url": "https://github.com/civarry/wickey/issues"
  },
  "keywords": [
    "llm",
    "api-keys",
    "proxy",
    "ai-agents",
    "secrets",
    "openai",
    "anthropic",
    "vault"
  ]
}
