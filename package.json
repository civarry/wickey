{
  "name": "wickey",
  "version": "0.1.0",
  "description": "Local proxy that hands out short-lived LLM API keys from an encrypted, passphrase-locked vault. Works on macOS, Windows and Linux.",
  "type": "module",
  "bin": {
    "wickey": "bin/wickey.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "src",
    "web/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.ts start",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "check": "svelte-check --workspace web --tsconfig ./tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
